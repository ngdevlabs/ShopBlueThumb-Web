{
  "components/ob-custom/global/ob-navigation-menu": "<nav class=\"navPages\">\n    <div class=\"container ob-mobile\">\n        <div class=\"header-promo\">\n                {{#if theme_settings.show_header_promo}}\n                    {{> components/ob-custom/global/ob-header-promo}}\n                {{/if}}\n                {{> components/ob-custom/global/ob-mobile-currency-selector}}\n            </div>\n        <div class=\"navPages-quickSearch ob-mobile\"></div>\n    </div>\n    <ul class=\"navPages-list\">\n        {{#each categories}}\n            <li class=\"navPages-item parent-item\">\n                {{> components/ob-custom/global/ob-navigation-list theme_settings=../theme_settings}}\n            </li>\n        {{/each}}\n        \n        {{#unless theme_settings.hide_content_navigation}}\n            {{#each pages}}\n                {{#if (occurrences ../theme_settings.navPages_included_pages name) '>' 0}}\n                <li class=\"navPages-item parent-item\">\n                    {{> components/ob-custom/global/ob-navigation-list-pages theme_settings=../theme_settings}}\n                </li>\n                {{/if}}\n            {{/each}}\n        {{/unless}}\n    </ul>\n    <ul class=\"navPages-list navPages-list--user\">\n        {{#if settings.show_wishlist}}\n            <li class=\"navPages-item\">\n                <a class=\"navPages-action\"\n                   href=\"{{urls.account.wishlists.all}}\"\n                   aria-label=\"{{lang 'account.mobile_nav.wishlists'}}\"\n                >\n                    {{#if theme_settings.theme_type '==' 'vogue'}}\n                        <svg><use xlink:href=\"#icon-duo-heart\" /></svg>\n                    {{else}} \n                        <svg><use xlink:href=\"#icon-heart\" /></svg>\n                    {{/if}}\n                    {{lang 'account.mobile_nav.wishlists'}}\n                </a>\n            </li>\n        {{/if}}\n        {{#if theme_settings.show_gift_blog_links}}\n            {{#if settings.gift_certificates_enabled}}\n                <li class=\"navPages-item\">\n                    <a class=\"navPages-action\"\n                       href=\"{{urls.gift_certificate.purchase}}\"\n                       aria-label=\"{{lang 'common.gift_cert'}}\"\n                    >\n                        {{#if theme_settings.theme_type '==' 'vogue'}}\n                            <svg><use xlink:href=\"#icon-duo-gift\" /></svg>\n                        {{else}} \n                            <svg><use xlink:href=\"#icon-gift\" /></svg>\n                        {{/if}}\n                        {{lang 'common.gift_cert'}}\n                    </a>\n                </li>\n            {{/if}}\n            {{#if settings.blog_enabled}}\n                <li class=\"navPages-item\">\n                    <a class=\"navPages-action\"\n                       href=\"{{blog.url}}\"\n                       aria-label=\"{{blog.name}}\"\n                    >\n                        {{#if theme_settings.theme_type '==' 'vogue'}}\n                            <svg><use xlink:href=\"#icon-duo-blog\" /></svg>\n                        {{else}} \n                            <svg><use xlink:href=\"#icon-blog\" /></svg>\n                        {{/if}}\n                        {{blog.name}}\n                    </a>\n                </li>\n            {{/if}}\n        {{/if}}\n    </ul>\n\n    <div class=\"ob-mobile\">\n        {{#if social_media}}\n            {{> components/common/social-links}}\n        {{/if}}\n    </div>\n</nav>\n",
  "components/ob-custom/global/ob-header-promo": "    {{#if theme_settings.theme_type '==' 'vogue'}}\n        <span>{{theme_settings.header_promo_tag_1}}</span>\n        <span>{{theme_settings.header_promo_tag_2}}</span>\n    {{else}}\n        {{theme_settings.header_promo_message}}\n    {{/if}}",
  "components/ob-custom/global/ob-mobile-currency-selector": "{{#if currency_selector.currencies.length '>' 1}}\n    <div class=\"ob-mobileCurrencySelector\">\n        <a class=\"navPages-action--currencySelector\"\n            href=\"#mobileCurrencySelection\"\n            data-dropdown=\"mobileCurrencySelection\"\n            aria-controls=\"currencySelection\"\n            aria-expanded=\"false\"\n        >\n            {{lang 'common.currency' code=currency_selector.active_currency_code}}\n            <i class=\"icon\" aria-hidden=\"true\">\n                <svg>\n                    <use xlink:href=\"#icon-chevron-down\" />\n                </svg>\n            </i>\n        </a>\n        <ul class=\"dropdown-menu\" id=\"mobileCurrencySelection\" aria-hidden=\"true\" tabindex=\"-1\">\n            {{#each currency_selector.currencies}}\n            <li class=\"dropdown-menu-item\">\n                <a href=\"{{{switch_url}}}\"\n                   data-currency-code=\"{{{code}}}\"\n                   {{#if cart_currency_switch_url.length '>' 0 }}\n                   data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                   {{/if}}\n                   data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                >\n                {{#if is_active}}\n                    <strong>{{name}}</strong>\n                {{else}}\n                    {{name}}\n                {{/if}}\n                </a>\n            </li>\n            {{/each}}\n        </ul>\n    </div>\n{{/if}}\n",
  "components/ob-custom/global/ob-navigation-list-pages": "{{#if children}}\n<a class=\"navPages-action has-subMenu{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   data-collapsible=\"navPages-{{dashcase name}}\"\n>\n    {{name}}\n    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n        <svg><use xlink:href=\"#icon-chevron-down\" /></svg>\n    </i>\n</a>\n<div class=\"navPage-subMenu\" id=\"navPages-{{dashcase name}}\" aria-hidden=\"true\" tabindex=\"-1\">\n    <div class=\"navPages-subMenu-wrap\">\n        {{#all theme_settings.is_night theme_settings.header_menu_background_image}}\n            <img class=\"menu-bg\" src=\"{{cdn 'assets/img/ob-custom/nav-bg.png'}}\" alt=\"Menu background\" />\n        {{/all}}\n        <ul class=\"navPage-subMenu-list\">\n            <div class=\"ob-child-group ob-child-group--full\">\n                <ul class=\"ob-child-group-list\">\n                    {{#each children}}\n                        <li class=\"navPage-subMenu-item\">\n                            {{#if children}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n\n                                <ul class=\"ob-grandchild-list\">\n                                    {{#each children}}\n                                        <li class=\"navPage-subMenu-item grandchild-item\">\n                                            <a class=\"navPage-subMenu-action navPages-action{{#if is_active}} activePage{{/if}}\"\n                                               href=\"{{url}}\"\n                                               aria-label=\"{{name}}\"\n                                            >\n                                                {{name}}\n                                            </a>\n                                        </li>\n                                    {{/each}}\n                                </ul>\n                            {{else}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n                            {{/if}}\n                        </li>\n                    {{/each}}\n                </ul>\n            </div>\n        </ul>\n    </div>\n</div>\n{{else}}\n<a class=\"navPages-action{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   aria-label=\"{{name}}\"\n>\n    {{name}}\n</a>\n{{/if}}\n",
  "components/common/social-links": "{{#if social_media}}\n    <ul class=\"socialLinks socialLinks--alt\">\n        {{#each social_media}}\n            <li class=\"socialLinks-item\">\n                <a class=\"icon icon--{{display_name}}\" href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">\n                    {{display_name}}\n                    <svg><use xlink:href=\"#icon-{{display_name}}\" /></svg>\n                </a>\n            </li>\n        {{/each}}\n    </ul>\n{{/if}}\n",
  "components/ob-custom/global/ob-navigation-list": "{{#if children}}\n<a class=\"navPages-action has-subMenu{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   data-collapsible=\"navPages-{{id}}\"\n>\n    {{name}}\n    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n        <svg><use xlink:href=\"#icon-chevron-down\" /></svg>\n    </i>\n</a>\n<div class=\"navPage-subMenu\" id=\"navPages-{{id}}\" aria-hidden=\"true\" tabindex=\"-1\">\n    <div class=\"navPages-subMenu-wrap\">\n        {{#all theme_settings.is_night (if theme_settings.header_menu_background_image '==' 'default')}}\n            <img class=\"menu-bg ob-desktop\" src=\"{{cdn 'assets/img/ob-custom/nav-bg.png'}}\" alt=\"Menu background\" />\n            <img class=\"menu-bg ob-mobile\" src=\"{{cdn 'assets/img/ob-custom/nav-bg.png'}}\" alt=\"Menu background\" />\n        {{/all}}\n        {{#all theme_settings.is_night (if theme_settings.header_menu_background_image '==' 'custom') theme_settings.header_menu_background_image_file}}\n            <img class=\"menu-bg ob-desktop\" src=\"{{getImageManagerImage theme_settings.header_menu_background_image_file}}\" alt=\"Menu background\" />\n            <img class=\"menu-bg ob-mobile\" src=\"{{getImageManagerImage theme_settings.header_menu_background_image_file_mobile}}\" alt=\"Menu background\" />\n        {{/all}}\n        <ul class=\"navPage-subMenu-list\">\n            {{#if theme_settings.navPages-subMenu-showImage}}\n                <li class=\"navPage-subMenu-item ob-header-link ob-desktop\">\n                    <a class=\"navPage-subMenu-action navPages-action image-action\"\n                       href=\"{{url}}\"\n                       aria-label=\"{{lang 'category.view_all.name' category=name}}\"\n                    >\n                        <div class=\"image-wrap ob-desktop\">\n                            {{#if image}}\n                                <img class=\"lazyload\" src=\"{{cdn 'assets/img/loading.svg'}}\" \n                                data-src=\"{{getImageSrcset image 1x=(default fallback_size '900w')}}\" alt=\"name\" />\n                                <span class=\"category-name\">{{name}}</span>\n                            {{else}}\n                                <span class=\"category-name\">{{name}}</span>\n                            {{/if}}\n                        </div>\n                    </a>\n                </li>\n            {{/if}}\n            <div class=\"ob-child-group {{#unless theme_settings.navPages-subMenu-showImage}}ob-child-group--full{{/unless}}\">\n                <a href=\"{{url}}\" class=\"view-all-desktop\">{{lang 'category.view_all.name' category=name}}</a>\n                <ul class=\"ob-child-group-list\">\n                    {{#each children}}\n                        <li class=\"navPage-subMenu-item\">\n                            {{#if children}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n\n                                <ul class=\"ob-grandchild-list\">\n                                    {{#each children}}\n                                        <li class=\"navPage-subMenu-item grandchild-item\">\n                                            <a class=\"navPage-subMenu-action navPages-action{{#if is_active}} activePage{{/if}}\"\n                                               href=\"{{url}}\"\n                                               aria-label=\"{{name}}\"\n                                            >\n                                                {{name}}\n                                            </a>\n                                        </li>\n                                    {{/each}}\n                                </ul>\n                            {{else}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n                            {{/if}}\n                        </li>\n                    {{/each}}\n                </ul>\n            </div>\n        </ul>\n    </div>\n</div>\n{{else}}\n<a class=\"navPages-action{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   aria-label=\"{{name}}\"\n>\n    {{name}}\n</a>\n{{/if}}\n"
}