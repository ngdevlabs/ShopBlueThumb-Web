{
  "components/ob-custom/home/ob-home-newsletter": "<div class=\"container\">\n    <div class=\"heading-2\">\n        {{{region name=\"newsletter_banner_title\"}}}\n    </div>\n    <div class=\"ob-body-lg\">\n        {{{region name=\"newsletter_banner_content\"}}}\n    </div>\n\n    <form class=\"form\" action=\"{{urls.subscribe.action}}\" method=\"post\">\n        <fieldset class=\"form-fieldset\">\n            <input type=\"hidden\" name=\"action\" value=\"subscribe\">\n            <input type=\"hidden\" name=\"nl_first_name\" value=\"bc\">\n            <input type=\"hidden\" name=\"check\" value=\"1\">\n            <div class=\"form-field\">\n                <label class=\"form-label is-srOnly\" for=\"nl_email\">{{lang 'common.email_address'}}</label>\n                <div class=\"form-prefixPostfix wrap\">\n                    <input class=\"form-input\"\n                           id=\"nl_email\"\n                           name=\"nl_email\"\n                           type=\"email\"\n                           value=\"{{customer.email}}\"\n                           placeholder=\"{{lang 'newsletter.email_placeholder'}}\"\n                           aria-describedby=\"alertBox-message-text\"\n                           aria-required=\"true\"\n                           required\n                    >\n                    <input class=\"button form-prefixPostfix-button--postfix ob-btn \n                        {{#unless theme_settings.theme_type '==' 'vogue'}}ob-cta-link {{/unless}}\n                        {{#if theme_settings.theme_type '==' 'vogue'}}ob-btn-border{{/if}}\"\n                           type=\"submit\"\n                           value=\"{{lang 'newsletter.subscribe_submit'}}\"\n                    >\n                </div>\n                {{#if settings.show_newsletter_summary }}\n                    <div class=\"footer-newsletter-summary\">{{settings.newsletter_summary}}</div>\n                {{/if}}\n            </div>\n        </fieldset>\n    </form>\n</div>\n"
}