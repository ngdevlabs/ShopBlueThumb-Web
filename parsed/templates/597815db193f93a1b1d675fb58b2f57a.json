{
  "components/ob-custom/global/ob-quick-search": "<div class=\"container\">\n    <form class=\"form\" onsubmit=\"return false\" data-url=\"{{urls.search}}\" data-quick-search-form>\n        <fieldset class=\"form-fieldset\">\n            <div class=\"form-field\">\n                <label class=\"is-srOnly\" for=\"nav-menu-quick-search\">{{lang \"search.quick_search.input_label\"}}</label>\n                <input class=\"form-input\"\n                       data-search-quick\n                       name=\"nav-menu-quick-search\"\n                       id=\"nav-menu-quick-search\"\n                       data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                       placeholder=\"{{lang 'search.quick_search.input_placeholder'}}\"\n                       autocomplete=\"off\"\n                >\n                <button class=\"button button--primary form-prefixPostfix-button--postfix\n                {{#if theme_settings.theme_type '==' 'vogue'}} ob-btn-border{{/if}}\" type=\"submit\">\n                    {{#if theme_settings.theme_type '==' 'vogue'}}\n                        <svg><use xlink:href=\"#icon-duo-search\" /></svg>\n                    {{else}}\n                        <svg><use xlink:href=\"#icon-search\" /></svg>\n                    {{/if}}\n                    {{lang 'search.results.form_button_text'}}\n                </button>\n            </div>\n        </fieldset>\n    </form>\n    <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n"
}