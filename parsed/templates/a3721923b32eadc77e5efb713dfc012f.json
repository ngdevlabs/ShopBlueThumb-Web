{
  "components/products/options/set-rectangle": "<div class=\"form-field\" data-product-attribute=\"set-rectangle\" role=\"radiogroup\" aria-labelledby=\"rectangleGroup_{{id}}\" data-option-name=\"{{this.display_name}}\">\n    <label class=\"form-label form-label--alternate form-label--inlineSmall\" id=\"rectangle-group-label\">\n        <span class=\"base-name\">{{this.display_name}}:</span>\n        {{> components/common/requireness-msg}}\n        <span data-option-value></span>\n    </label>\n\n    {{#unless required}}\n        <input\n            class=\"form-radio\"\n            type=\"radio\"\n            id=\"attribute_rectangle__{{id}}_none\"\n            name=\"attribute[{{id}}]\"\n            value=\"\"\n            checked=\"{{#if defaultValue '==' ''}}checked{{/if}}\"\n            aria-label=\"{{lang 'products.none'}}\"\n        >\n        <label class=\"form-option\" for=\"attribute_rectangle__{{id}}_none\">\n            <span class=\"form-option-variant\">{{lang 'products.none'}}</span>\n        </label>\n    {{/unless}}\n\n    {{#each this.values}}\n    <div class=\"form-option-wrapper\">\n        <input\n            class=\"form-radio\"\n            type=\"radio\"\n            id=\"attribute_rectangle__{{../id}}_{{id}}\"\n            name=\"attribute[{{../id}}]\"\n            value=\"{{id}}\"\n            {{#if selected}}\n                checked\n                data-default\n            {{/if}}\n            {{#if ../required}}required{{/if}}\n            aria-label=\"{{this.label}}\"\n        >\n        <label class=\"form-option\" for=\"attribute_rectangle__{{../id}}_{{id}}\" data-product-attribute-value=\"{{id}}\">\n            <span class=\"form-option-variant\">{{this.label}}</span>\n        </label>\n    </div>\n    {{/each}}\n</div>\n",
  "components/common/requireness-msg": "<small>\n    {{#if required}}\n    ({{lang 'common.required'}})\n    {{else}}\n    {{lang 'common.optional'}}\n    {{/if}}\n</small>\n"
}