{
  "components/products/add-to-cart": "{{{region name=\"product_above_quantity\"}}}\n\n<div id=\"add-to-cart-wrapper\" class=\"add-to-cart-wrapper\">\n    {{#if theme_settings.show_product_quantity_box}}\n        {{inject 'productQuantityErrorMessage'  (lang 'products.quantity_error_message')}}\n        <div class=\"form-field form-field--increments\" {{#unless product.can_purchase}}style=\"display: none\"{{/unless}}>\n                <div class=\"form-increment\" data-quantity-change>\n                    <button class=\"button button--icon\" data-action=\"dec\" title=\"{{lang 'products.quantity_decrease' name=product.title}}\">\n                        <span class=\"is-srOnly\">{{lang 'products.quantity_decrease' name=product.title}}</span>\n                        <i class=\"icon\" aria-hidden=\"true\">\n                            <svg><use xlink:href=\"#icon-minus\" /></svg>\n                        </i>\n                    </button>\n                    <input class=\"form-input form-input--incrementTotal\"\n                           id=\"qty[]\"\n                           name=\"qty[]\"\n                           type=\"tel\"\n                           value=\"{{#if product.min_purchase_quantity}}{{product.min_purchase_quantity}}{{else}}1{{/if}}\"\n                           data-quantity-min=\"{{product.min_purchase_quantity}}\"\n                           data-quantity-max=\"{{product.max_purchase_quantity}}\"\n                           min=\"1\"\n                           pattern=\"[0-9]*\"\n                           aria-live=\"polite\"\n                           title=\"Product Quantity\">\n                    <label class=\"form-label form-label--alternate\" for=\"qty[]\">{{lang 'products.quantity'}}</label>\n                    <button class=\"button button--icon\" data-action=\"inc\" title=\"{{lang 'products.quantity_increase' name=product.title}}\">\n                        <span class=\"is-srOnly\">{{lang 'products.quantity_increase' name=product.title}}</span>\n                        <i class=\"icon\" aria-hidden=\"true\">\n                            <svg><use xlink:href=\"#icon-plus\" /></svg>\n                        </i>\n                    </button>\n                </div>\n\n                <div class=\"form-field--stock{{#unless product.stock_level}} u-hiddenVisually{{/unless}}\">\n                    <label class=\"form-label form-label--alternate\">\n                        {{lang 'products.current_stock'}}\n                        <span data-product-stock>{{product.stock_level}}</span>\n                    </label>\n                </div>\n        </div>\n    {{/if}}\n\n    <div class=\"alertBox alertBox--error productAttributes-message\" style=\"display:none\">\n        <div class=\"alertBox-icon\">\n            &excl;\n        </div>\n        <p class=\"alertBox-message\"></p>\n    </div>\n    {{#or customer (if settings.hide_price_from_guests '!==' true)}}\n        <div class=\"form-action\">\n            <input\n                id=\"form-action-addToCart\"\n                data-wait-message=\"{{lang 'products.adding_to_cart'}}\"\n                class=\"button button--primary\"\n                type=\"submit\"\n                value=\"{{#if product.pre_order}}{{lang 'products.pre_order'}}{{else}}{{lang 'products.add_to_cart'}}{{/if}}\" \n                {{#unless product.can_purchase}}disabled{{/unless}}\n            >\n            {{#if settings.show_wishlist}}\n                <a class=\"ob-btn dropdown-menu-button ob-wishlist-action\" \n                   title=\"Add to Wishlist\"\n                   aria-controls=\"wishlist-dropdown\"\n                   aria-expanded=\"false\"\n                   data-dropdown=\"wishlist-dropdown\"\n                   href=\"#\">\n                    {{#if theme_settings.theme_type '==' 'vogue'}}\n                        <svg><use xlink:href=\"#icon-duo-heart\" /></svg>\n                    {{else}}\n                        <svg><use xlink:href=\"#icon-heart\" /></svg>\n                    {{/if}}\n                </a>\n            {{/if}}\n            <span class=\"product-status-message aria-description--hidden\">{{lang 'products.adding_to_cart'}} {{lang 'category.add_cart_announcement'}}</span>\n        </div>\n    {{/or}}\n</div>\n"
}