{
  "components/ob-custom/home/ob-home-hero-carousel": "<div class=\"ob-top-hero-carousel\">\n  {{#if theme_settings.theme_type '==' 'night'}}\n    {{> components/ob-custom/home/carousel-night}}\n  {{else}}\n    {{> components/ob-custom/home/carousel-vogue}}\n  {{/if}}\n</div>",
  "components/ob-custom/home/carousel-night": "  <div class=\"container\">\n    <div class=\"ob-hero-container mobile-carousel ob-mobile\">\n      {{#each carousel.slides}}\n        <div class=\"ob-hero-image-container\">\n          {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n            <img\n              {{#if @first}}\n                src=\"{{image}}\"\n                fetchpriority=\"high\"\n              {{else}}\n                src=\"{{cdn 'assets/img/loading.svg'}}\"\n                data-src=\"{{image}}\"\n              {{/if}}\n              \n              class=\"ob-hero-image {{#unless @first}}lazyload{{/unless}}\"\n              alt=\"{{alt_text}}\"\n            />\n            <div class=\"ob-hero-content\">\n              {{#if text}}\n                <p class=\"hero-sub-heading\">\n                  {{{text}}}\n                </p>\n              {{/if}}\n              {{#if heading}}\n                <h2 class=\"hero-heading\">\n                  {{{heading}}}\n                </h2>\n              {{/if}}\n              {{#if button_text}}\n                <a class=\"ob-btn ob-btn--primary\" href=\"{{url}}\">\n                  {{{button_text}}}\n                </a>\n              {{/if}}\n            </div>\n          {{#unless button_text}}</a>{{/unless}}\n        </div>\n      {{/each}}\n    </div>\n\n    <div class=\"ob-hero-container desktop-carousel ob-desktop\">\n      <div class=\"ob-hero-image-container\">\n        <div class=\"slider-container ob-image-carousel\">\n          {{#each carousel.slides}}\n            {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n              <div class=\"image-wrap\">\n                <img\n                  {{#if @first}}\n                    src=\"{{image}}\"\n                    fetchpriority=\"high\"\n                  {{else}}\n                    src=\"{{cdn 'assets/img/loading.svg'}}\"\n                    data-src=\"{{image}}\"\n                  {{/if}}\n                  \n                  class=\"ob-hero-image {{#unless @first}}lazyload{{/unless}}\"\n                  alt=\"{{alt_text}}\"\n                />\n              </div>\n            {{#unless button_text}}</a>{{/unless}}\n          {{/each}}\n        </div>\n\n        <div class=\"container ob-content-carousel-container\">\n          <div class=\"ob-content-carousel rellax\" data-rellax-speed=\"-2\">\n            {{#each carousel.slides}}\n              <div class=\"ob-slide\">\n                {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n                  {{#if text}}\n                    <h2 class=\"hero-sub-heading\">\n                      {{{text}}}\n                    </h2>\n                  {{/if}}\n                  {{#if heading}}\n                    <h2 class=\"hero-heading\">\n                      {{{heading}}}\n                    </h2>\n                  {{/if}}\n                  {{#if button_text}}\n                    <a class=\"ob-btn ob-btn--primary\" href=\"{{url}}\">\n                      {{{button_text}}}\n                    </a>\n                  {{/if}}\n                {{#unless button_text}}</a>{{/unless}}\n              </div>\n            {{/each}}\n          </div>\n        </div>\n\n          <div class=\"ob-carousel-arrows-container {{#unless theme_settings.homepage_show_carousel_arrows}}ob-hidden{{/unless}}\">\n            <div class=\"container\">\n              <div class=\"ob-carousel-arrows\">\n                <button id=\"carousel-trigger-prev\" class=\"slick-prev\">Previous</button>\n                <button id=\"carousel-trigger-next\" class=\"slick-next\">Next</button>\n              </div>\n            </div>\n          </div>\n      </div>\n    </div>\n  </div>",
  "components/ob-custom/home/carousel-vogue": "    <div class=\"ob-hero-container mobile-carousel ob-mobile\">\n      {{#each carousel.slides}}\n        <div class=\"ob-hero-image-container\">\n          {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n            <img\n              {{#if @first}}\n                src=\"{{image}}\"\n                fetchpriority=\"high\"\n              {{else}}\n                src=\"{{cdn 'assets/img/loading.svg'}}\"\n                data-src=\"{{image}}\"\n              {{/if}}\n              \n              class=\"ob-hero-image {{#unless @first}}lazyload{{/unless}}\"\n              alt=\"{{alt_text}}\"\n            />\n            <div class=\"ob-hero-content\">\n              {{#if text}}\n                <p class=\"hero-sub-heading pre-title\">\n                  {{{text}}}\n                </p>\n              {{/if}}\n              {{#if heading}}\n                <h2 class=\"hero-heading\">\n                  {{{heading}}}\n                </h2>\n              {{/if}}\n              {{#if button_text}}\n                <a class=\"ob-btn ob-btn--primary\" href=\"{{url}}\">\n                  {{{button_text}}}\n                </a>\n              {{/if}}\n            </div>\n          {{#unless button_text}}</a>{{/unless}}\n        </div>\n      {{/each}}\n    </div>\n\n    <div class=\"ob-hero-container desktop-carousel ob-desktop\">\n      <div class=\"ob-hero-image-container\">\n        <div class=\"slider-container ob-image-carousel\">\n          {{#each carousel.slides}}\n            <div class=\"image-wrap\">\n              {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n                <img\n                  {{#if @first}}\n                    src=\"{{image}}\"\n                    fetchpriority=\"high\"\n                  {{else}}\n                    src=\"{{cdn 'assets/img/loading.svg'}}\"\n                    data-src=\"{{image}}\"\n                  {{/if}}\n                  \n                  class=\"ob-hero-image {{#unless @first}}lazyload{{/unless}}\"\n                  alt=\"{{alt_text}}\"\n                />\n              {{#unless button_text}}</a>{{/unless}}\n            </div>\n          {{/each}}\n        </div>\n\n        <div class=\"container ob-content-carousel-container\">\n          <div class=\"ob-content-carousel rellax\" data-rellax-speed=\"-2\">\n            {{#each carousel.slides}}\n              <div class=\"ob-slide\">\n                {{#unless button_text}}<a href=\"{{url}}\">{{/unless}}\n                  {{#if text}}\n                    <h2 class=\"hero-sub-heading pre-title\">\n                      {{{text}}}\n                    </h2>\n                  {{/if}}\n                  {{#if heading}}\n                    <h2 class=\"hero-heading\">\n                      {{{heading}}}\n                    </h2>\n                  {{/if}}\n                  {{#if button_text}}\n                    <a class=\"ob-btn ob-btn--primary\" href=\"{{url}}\">\n                      {{{button_text}}}\n                    </a>\n                  {{/if}}\n                {{#unless button_text}}</a>{{/unless}}\n              </div>\n            {{/each}}\n          </div>\n        </div>\n\n          <div class=\"ob-carousel-arrows-container {{#unless theme_settings.homepage_show_carousel_arrows}}ob-hidden{{/unless}}\">\n            <div class=\"container\">\n              <div class=\"ob-carousel-arrows\">\n                <button id=\"carousel-trigger-prev\" class=\"slick-prev\">Previous</button>\n                <button id=\"carousel-trigger-next\" class=\"slick-next\">Next</button>\n              </div>\n            </div>\n          </div>\n      </div>\n    </div>"
}