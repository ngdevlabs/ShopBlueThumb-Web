{
  "components/ob-custom/global/ob-navigation-list-pages": "{{#if children}}\n<a class=\"navPages-action has-subMenu{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   data-collapsible=\"navPages-{{dashcase name}}\"\n>\n    {{name}}\n    <i class=\"icon navPages-action-moreIcon\" aria-hidden=\"true\">\n        <svg><use xlink:href=\"#icon-chevron-down\" /></svg>\n    </i>\n</a>\n<div class=\"navPage-subMenu\" id=\"navPages-{{dashcase name}}\" aria-hidden=\"true\" tabindex=\"-1\">\n    <div class=\"navPages-subMenu-wrap\">\n        {{#all theme_settings.is_night theme_settings.header_menu_background_image}}\n            <img class=\"menu-bg\" src=\"{{cdn 'assets/img/ob-custom/nav-bg.png'}}\" alt=\"Menu background\" />\n        {{/all}}\n        <ul class=\"navPage-subMenu-list\">\n            <div class=\"ob-child-group ob-child-group--full\">\n                <ul class=\"ob-child-group-list\">\n                    {{#each children}}\n                        <li class=\"navPage-subMenu-item\">\n                            {{#if children}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n\n                                <ul class=\"ob-grandchild-list\">\n                                    {{#each children}}\n                                        <li class=\"navPage-subMenu-item grandchild-item\">\n                                            <a class=\"navPage-subMenu-action navPages-action{{#if is_active}} activePage{{/if}}\"\n                                               href=\"{{url}}\"\n                                               aria-label=\"{{name}}\"\n                                            >\n                                                {{name}}\n                                            </a>\n                                        </li>\n                                    {{/each}}\n                                </ul>\n                            {{else}}\n                                <a class=\"navPage-subMenu-action navPages-action mid--level{{#if is_active}} activePage{{/if}}\"\n                                   href=\"{{url}}\"\n                                   aria-label=\"{{name}}\"\n                                >\n                                    {{name}}\n                                </a>\n                            {{/if}}\n                        </li>\n                    {{/each}}\n                </ul>\n            </div>\n        </ul>\n    </div>\n</div>\n{{else}}\n<a class=\"navPages-action{{#if is_active}} activePage{{/if}} top--level\"\n   href=\"{{url}}\"\n   aria-label=\"{{name}}\"\n>\n    {{name}}\n</a>\n{{/if}}\n"
}